{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$PLUGIN_ROOT/.codex-plugin/fsm-ledger-hook stop",
            "async": true,
            "statusMessage": "fsm-ledger Stop capture"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$PLUGIN_ROOT/.codex-plugin/fsm-ledger-hook session_end",
            "statusMessage": "fsm-ledger SessionEnd queue"
          }
        ]
      }
    ]
  }
}
