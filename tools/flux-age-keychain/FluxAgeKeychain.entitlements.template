<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by package.sh. @TEAM_ID@ and @BUNDLE_ID@ come from the environment at
     signing time; @ACCESS_GROUP@ is @TEAM_ID@.<FLUX_AGE_GROUP_SUFFIX>
     (default com.example.flux-age).
     No team-specific value is committed. The Developer ID
     provisioning profile embedded in the bundle must authorize every entry. -->
<plist version="1.0">
<dict>
	<key>com.apple.application-identifier</key>
	<string>@TEAM_ID@.@BUNDLE_ID@</string>
	<key>com.apple.developer.team-identifier</key>
	<string>@TEAM_ID@</string>
	<key>keychain-access-groups</key>
	<array>
		<string>@ACCESS_GROUP@</string>
	</array>
</dict>
</plist>
