<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.djh00t.codex-turn-events.reconcile</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>@TOOL_DIR@/codex_turn_events.py</string>
    <string>reconcile</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>47</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>@STATE_DIR@/reconcile-last.json</string>
  <key>StandardErrorPath</key>
  <string>@STATE_DIR@/reconcile-error.log</string>
</dict>
</plist>
