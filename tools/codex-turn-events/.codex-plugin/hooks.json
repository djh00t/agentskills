{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$PLUGIN_ROOT/.codex-plugin/codex-turn-events-hook stop",
            "async": true,
            "statusMessage": "codex-turn-events Stop"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$PLUGIN_ROOT/.codex-plugin/codex-turn-events-hook permission_request",
            "async": true,
            "statusMessage": "codex-turn-events needs approval"
          }
        ]
      }
    ]
  }
}
